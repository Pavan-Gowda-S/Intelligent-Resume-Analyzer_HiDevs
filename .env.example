# Intelligent Resume Analyzer — Environment Configuration (Optional)
# Copy to .env if you need to override default settings.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING

# Streamlit Port (Default is 8501)
STREAMLIT_SERVER_PORT=8501

# Streamlit Headless Mode (Default is true)
STREAMLIT_SERVER_HEADLESS=true
